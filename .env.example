# Token used by the Qwen platform to connect to /agent.
GLASSCODEX_AGENT_TOKEN=

# Token used by the Mac bridge to connect to /bridge.
GLASSCODEX_BRIDGE_TOKEN=

# Comma-separated device IDs allowed to control this computer.
# Set this before using the connector with a real pair of glasses.
GLASSCODEX_ALLOWED_DEVICES=

# Cloud service bind address. Keep loopback and expose it through HTTPS.
GLASSCODEX_HOST=127.0.0.1
GLASSCODEX_PORT=8792

# Optional fallback when the platform reconnects without its page list.
GLASSCODEX_TEMPLATE_ID=
