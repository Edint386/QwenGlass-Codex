        <view floating="true" left="30" top="0" width="30" height="60"><view floating="true" left="-30" top="0" width="60" height="60" rotate="{{a2}}deg"><view floating="true" left="0" top="0" width="30" height="60"><view floating="true" left="2" top="2" width="56" height="56" radius="28" border-width="5" border-color="{{u2}}" /></view></view></view>
