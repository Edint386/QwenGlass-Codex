<view xmlns:a="waft://dsl" width="100%" height="100%" flex-flow="row" flex-cross="start" column-gap="0" bg-color="#000000">
  <!-- codex-panel：Codex Desktop 任务面板。
       左栏是提问和回复/实时进度，右栏是计划、改动、上下文和三个圆环。
       m：0 回复，1 字号，2 草稿，3 实时两栏，4 任务列表，5 菜单，6 快捷回复，7 计划与改动。
       P：回复页六槽；i 是当前槽；R 是实时时间流七行；PL 是计划五行。
       绑定上限 128，数据键上限 64，根节点直接子元素上限 64。 -->
  <page-meta theme="no-status-bar|disable-chat-bar" screen-awake="keep" confirm-back-text="再双击一次退出" />
  <prompt-config text="" />
  <json st='{"slot": {{i}}, "c": {{c}}, "dv": {{dv}}, "m": {{m}}, "k": {{d:k}}, "s": {{d:s}}, "l": {{lv}}, "f": {{d:fv}}}' />
  <lifecycle-event on-show="svc://ui-action?mode=mcp&amp;name=show&amp;params={{json:st}}" on-hide="svc://ui-action?mode=mcp&amp;name=hide&amp;params={{json:st}}" on-focus="svc://ui-action?mode=mcp&amp;name=focus&amp;params={{json:st}}" on-blur="svc://ui-action?mode=mcp&amp;name=blur&amp;params={{json:st}}" on-screen-on="svc://ui-action?mode=mcp&amp;name=screen_on&amp;params={{json:st}}" on-screen-off="svc://ui-action?mode=mcp&amp;name=screen_off&amp;params={{json:st}}" />
  <data an="0,0,1,1,linear" g="0" k="0" s="0" fv="18" />

  <key-event a:if="{{m == 0}}" on-key-enter="emit://event/menu?" on-key-next="emit://event/tn?" on-key-prev="emit://event/tp?" />
  <key-event a:elif="{{m == 3}}" on-key-enter="emit://event/menu?" on-key-next="svc://ui-action?mode=mcp&amp;name=newer&amp;params={{json:st}}" on-key-prev="svc://ui-action?mode=mcp&amp;name=older&amp;params={{json:st}}" />
  <key-event a:elif="{{m > 6}}" on-key-enter="emit://event/menu?" on-key-next="emit://event/nop?" on-key-prev="emit://event/nop?" />
  <key-event a:elif="{{m > 3}}" on-key-enter="emit://event/pick?k={{c}}&amp;s={{m}}" on-key-next="emit://event/cn?" on-key-prev="emit://event/cp?" />
  <key-event a:elif="{{m == 1}}" on-key-enter="emit://event/fs?" on-key-next="emit://event/fu?" on-key-prev="emit://event/fd?" />
  <key-event a:else="" on-key-enter="emit://event/send?" on-key-next="emit://event/drop?" on-key-prev="emit://event/drop?" on-key-back="svc://ui-action?mode=mcp&amp;name=exit&amp;params={{json:st}}" />

  <event match="event://tn?" a:if="{{i == hi}}" action="dataSource://update?m=3&amp;rp=1" />
  <event match="event://tn?" a:if="{{i == hi}}" action="svc://ui-action?mode=mcp&amp;name=more&amp;params={{json:st}}" />
  <event match="event://tn?" a:if="{{i != hi}}" action="dataSource://update?i={{nx[i].n}}" />
  <event match="event://tp?" a:if="{{i != lo}}" action="dataSource://update?i={{pv[i].n}}" />
  <event match="event://t" action="svc://ui-action?mode=mcp&amp;name=turn&amp;params={{json:st}}" />

  <event match="event://cn?" action="dataSource://update?c={{ln[c].n}}" />
  <event match="event://cn?" action="data://update?g={{d:g + 1}}&amp;an={{ln[c].d}},0,250,1,ease-out" />
  <event match="event://cn?" action="emit://event/d25?n=25&amp;g={{d:g}}" />
  <event match="event://cp?" action="dataSource://update?c={{lp[c].n}}" />
  <event match="event://cp?" action="data://update?g={{d:g + 1}}&amp;an={{lp[c].d}},0,250,1,ease-out" />
  <event match="event://cp?" action="emit://event/d25?n=25&amp;g={{d:g}}" />
  <event match="event://d1" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d2" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d3" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d4" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d5" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d6" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d7" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d8" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d9" action="emit://event/d{{e:n - 1}}?n={{e:n - 1}}&amp;g={{e:g}}" />
  <event match="event://d0?" a:if="{{e:g == d:g}}" action="data://update?an=0,0,1,1,linear" />

  <event match="event://menu?" action="data://update?an=0,0,1,1,linear" />
  <event match="event://menu?" action="dataSource://update?c=11&amp;m=5" />
  <event match="event://menu?" action="svc://ui-action?mode=mcp&amp;name=menu&amp;params={{json:st}}" />
  <event match="event://pick?" action="data://update?an=0,0,1,1,linear&amp;k={{e:k}}&amp;s={{e:s}}&amp;fv={{fz}}" />
  <event match="event://pick?" a:if="{{e:k == 16}}" action="dataSource://update?m=1" />
  <event match="event://pick?" a:elif="{{e:k == 15}}" action="dataSource://update?c=6&amp;m=6" />
  <event match="event://pick?" a:elif="{{e:k == 14}}" action="dataSource://update?m=7" />
  <event match="event://pick?" a:elif="{{e:k == 13}}" action="dataSource://update?m={{mv.m}}&amp;rp={{mv.p}}" />
  <event match="event://pick?" a:elif="{{e:k == 12}}" action="dataSource://update?c=0&amp;m=4" />
  <event match="event://pick?" a:elif="{{e:k == 6}}" action="dataSource://update?c=15&amp;m=5" />
  <event match="event://pick?" a:elif="{{e:k == 0}}" action="dataSource://update?c=12&amp;m=5" />
  <event match="event://pick?" a:else="" action="dataSource://update?m=0" />
  <event match="event://pick?" action="svc://ui-action?mode=mcp&amp;name=pick&amp;params={{json:st}}" />

  <event match="event://fu?" a:if="{{d:fv != 24}}" action="data://update?fv={{d:fv + 2}}" />
  <event match="event://fd?" a:if="{{d:fv != 16}}" action="data://update?fv={{d:fv - 2}}" />
  <event match="event://fs?" action="dataSource://update?m=0" />
  <event match="event://fs?" action="svc://ui-action?mode=mcp&amp;name=font&amp;params={{json:st}}" />
  <event match="event://send?" action="dataSource://update?m=0" />
  <event match="event://send?" action="svc://ui-action?mode=mcp&amp;name=send&amp;params={{json:st}}" />
  <event match="event://drop?" action="dataSource://update?m=0" />
  <event match="event://drop?" action="svc://ui-action?mode=mcp&amp;name=drop&amp;params={{json:st}}" />

  <view width="640" height="290">
